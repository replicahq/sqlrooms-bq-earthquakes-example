{
  "name": "sqlrooms-bq-earthquakes-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "apache-arrow": "17.0.0",
    "@sqlrooms/bigquery": "file:../sqlrooms-bigquery",
    "@sqlrooms/duckdb": "0.27.0-rc.0",
    "@sqlrooms/mosaic": "0.27.0-rc.0",
    "@sqlrooms/room-shell": "0.27.0-rc.0",
    "@sqlrooms/sql-editor": "0.27.0-rc.0",
    "@sqlrooms/ui": "0.27.0-rc.0",
    "@geoarrow/deck.gl-layers": "^0.3.1",
    "@deck.gl/react": "^9.2.5",
    "lucide-react": "^0.555.0",
    "maplibre-gl": "^5.12.0",
    "react-map-gl": "^8.1.0",
    "immer": "^11.0.1",
    "zod": "^4.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.0",
    "vite": "^5.4.0"
  }
